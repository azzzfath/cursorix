{
  "name": "cursorix-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter cursorix build && pnpm --filter demo build && cp -R apps/demo/dist .",
    "build:package": "pnpm --filter cursorix build",
    "build:demo": "pnpm --filter demo build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
