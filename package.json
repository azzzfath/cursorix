{
  "name": "cursor-depok-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter cursor-depok build && pnpm --filter demo build && cp -R apps/demo/dist .",
    "build:package": "pnpm --filter cursor-depok build",
    "build:demo": "pnpm --filter demo build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
